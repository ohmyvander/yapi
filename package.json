{
  "name": "yapi-vendor",
  "version": "1.11.0",
  "description": "YAPI",
  "main": "server/app.js",
  "scripts": {
    "check-env": "node scripts/check-env.js",
    "generate-plugin-module": "node scripts/generate-plugin-module.js",
    "dev-copy-icon": "node scripts/copy-iconfont.js",
    "dev-server": " nodemon server/app.js dev -L",
    "install-server": " node server/install.js",
    "dev-client": "npm run generate-plugin-module && npm run dev-copy-icon && webpack serve --mode development --port 4000",
    "dev": "npm run dev-server & npm run dev-client",
    "start": " node server/app.js",
    "test": "ava --node-arguments=\"--require=./test/babel-register.js\"",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "build-client": "npm run generate-plugin-module && webpack --mode production",
    "npm-publish": "node ./npm-publish.js",
    "docs": "ydoc build"
  },
  "scripts-info": {
    "start": "运行生产环境服务器",
    "install-server": "初始化数据库数据，用于安装",
    "dev": "运行开发服务器",
    "dev-server": "运行后端开发服务器",
    "dev-client": "运行前端开发服务器",
    "test": "执行测试"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:YMFE/yapi.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^5.5.1",
    "ajv-i18n": "^2.2.0",
    "axios": "1.6.8",
    "compare-versions": "^3.4.0",
    "copy-to-clipboard": "3.0.8",
    "cpu-load": "^1.0.0",
    "crypto-js": "^3.1.9-1",
    "easy-json-schema": "0.0.2-beta",
    "fs-extra": "^3.0.1",
    "generate-schema": "^2.6.0",
    "immer": "^1.1.1",
    "js-base64": "^2.3.2",
    "json-schema-faker": "0.5.0-rc16",
    "json5": "0.5.1",
    "jsondiffpatch": "0.3.11",
    "jsonwebtoken": "7.4.1",
    "jsrsasign": "^8.0.12",
    "koa": "2.15.4",
    "koa-body": "4.2.0",
    "koa-router": "^7.0.1",
    "koa-static": "3.0.0",
    "koa-websocket": "4.0.0",
    "ldapjs": "^1.0.1",
    "markdown-it": "8.4.0",
    "markdown-it-anchor": "4.0.0",
    "markdown-it-table-of-contents": "0.3.2",
    "md5": "2.2.1",
    "mockjs": "1.0.1-beta3",
    "moment": "^2.19.3",
    "node-schedule": "^1.3.2",
    "nodemailer": "4.0.1",
    "pg": "8.8.0",
    "punycode": "1.4.1",
    "qs": "^6.7.0",
    "request": "2.81.0",
    "safeify": "^5.0.5",
    "sha.js": "2.4.9",
    "sha1": "1.1.1",
    "swagger-client": "^3.5.1",
    "underscore": "1.8.3",
    "yapi-plugin-qsso": "^1.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.22.20",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.22.15",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-transform-runtime": "7.22.15",
    "@babel/preset-env": "7.22.20",
    "@babel/preset-react": "7.22.15",
    "@babel/register": "7.22.15",
    "@babel/runtime": "7.22.15",
    "antd": "3.26.20",
    "ava": "3.15.0",
    "babel-eslint": "^7.2.3",
    "babel-loader": "8.3.0",
    "babel-plugin-import": "^1.3.1",
    "babel-plugin-module-resolver": "4.1.0",
    "brace": "^0.10.0",
    "compression-webpack-plugin": "9.2.0",
    "conventional-changelog-cli": "^2.1.1",
    "core-decorators": "^0.17.0",
    "css-loader": "6.8.1",
    "eslint": "^3.19.0",
    "eslint-plugin-import": "^2.2.0",
    "eslint-plugin-react": "^7.1.0",
    "ghooks": "^2.0.0",
    "json-schema-editor-visual": "^1.0.23",
    "less": "3.13.1",
    "less-loader": "7.3.0",
    "markdown-it-include": "^1.0.0",
    "mini-css-extract-plugin": "2.7.6",
    "nodemon": "^1.11.0",
    "prop-types": "^15.5.10",
    "rc-queue-anim": "^1.2.0",
    "rc-scroll-anim": "^1.0.7",
    "rc-tween-one": "^1.5.5",
    "react": "17.0.2",
    "react-dnd": "^2.5.1",
    "react-dnd-html5-backend": "^2.5.1",
    "react-dom": "17.0.2",
    "react-redux": "^5.0.5",
    "react-router-dom": "5.3.4",
    "reactabular-dnd": "^8.9.0",
    "reactabular-table": "^8.9.0",
    "recharts": "^1.0.0-beta.0",
    "redux": "^3.7.1",
    "redux-devtools": "^3.4.0",
    "redux-devtools-dock-monitor": "^1.1.2",
    "redux-devtools-log-monitor": "^1.3.0",
    "redux-promise": "^0.5.3",
    "rewire": "^2.5.2",
    "sass": "1.32.13",
    "sass-loader": "12.6.0",
    "table-resolver": "^3.2.0",
    "validate-commit-msg": "^2.12.2",
    "webpack": "5.88.2",
    "webpack-cli": "4.10.0",
    "webpack-dev-server": "4.15.1",
    "ydoc-plugin-img-view": "^1.0.1"
  },
  "config": {
    "ghooks": {
      "commit-msg": "validate-commit-msg"
    },
    "validate-commit-msg": {
      "types": [
        "feat",
        "fix",
        "docs",
        "test",
        "chore",
        "refactor",
        "opti"
      ],
      "warnOnFail": false,
      "maxSubjectLength": 100,
      "subjectPattern": ".+",
      "subjectPatternErrorMsg": "请输入message信息!",
      "helpMessage": "Commit message 格式错误， http://www.ruanyifeng.com/blog/2016/01/commit_message_change_log.html"
    }
  },
  "engines": {
    "node": "12.22.x",
    "npm": "^6.14.0"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "loose": true,
          "modules": false,
          "targets": {
            "node": "12.22"
          }
        }
      ],
      "@babel/preset-react"
    ],
    "plugins": [
      [
        "@babel/plugin-proposal-decorators",
        {
          "legacy": true
        }
      ],
      [
        "@babel/plugin-proposal-class-properties",
        {
          "loose": true
        }
      ],
      "@babel/plugin-proposal-object-rest-spread",
      [
        "@babel/plugin-transform-runtime",
        {
          "regenerator": true
        }
      ],
      [
        "module-resolver",
        {
          "alias": {
            "client": "./client",
            "common": "./common",
            "exts": "./exts",
            "models": "./server/models",
            "utils": "./server/utils",
            "yapi.js": "./server/yapi.js"
          }
        }
      ]
    ],
    "env": {
      "test": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "loose": true,
              "modules": "commonjs",
              "targets": {
                "node": "12.22"
              }
            }
          ],
          "@babel/preset-react"
        ]
      }
    }
  },
  "ava": {
    "files": [
      "test/**/*.js",
      "!test/babel-register.js"
    ]
  }
}
