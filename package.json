{
  "name": "yapi-vendor",
  "version": "1.11.0",
  "description": "YAPI",
  "main": "server/app.js",
  "scripts": {
    "check-env": "node scripts/check-env.js",
    "dev-server": " nodemon server/app.js dev -L",
    "install-server": " node server/install.js",
    "dev-client": "npm --prefix client run dev",
    "dev": "npm run dev-server",
    "start": " node server/app.js",
    "test": "ava --node-arguments=\"--require=./test/babel-register.js\"",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "build-client": "npm --prefix client run build",
    "npm-publish": "node ./npm-publish.js"
  },
  "scripts-info": {
    "start": "运行生产环境服务器",
    "install-server": "初始化数据库数据，用于安装",
    "dev": "运行后端开发服务器",
    "dev-server": "运行后端开发服务器",
    "dev-client": "运行前端开发服务器",
    "test": "执行测试"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:YMFE/yapi.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^5.5.1",
    "ajv-i18n": "^2.2.0",
    "axios": "1.6.8",
    "compare-versions": "^3.4.0",
    "cpu-load": "^1.0.0",
    "crypto-js": "^3.1.9-1",
    "easy-json-schema": "0.0.2-beta",
    "fs-extra": "^3.0.1",
    "js-base64": "^2.3.2",
    "json-schema-faker": "0.5.0-rc16",
    "json5": "0.5.1",
    "jsondiffpatch": "0.3.11",
    "jsonwebtoken": "7.4.1",
    "jsrsasign": "^8.0.12",
    "koa": "2.15.4",
    "koa-body": "4.2.0",
    "koa-router": "^7.0.1",
    "koa-static": "3.0.0",
    "koa-websocket": "4.0.0",
    "ldapjs": "^1.0.1",
    "markdown-it": "8.4.0",
    "markdown-it-anchor": "4.0.0",
    "markdown-it-table-of-contents": "0.3.2",
    "md5": "2.2.1",
    "mockjs": "1.0.1-beta3",
    "node-schedule": "^1.3.2",
    "nodemailer": "4.0.1",
    "pg": "8.8.0",
    "punycode": "1.4.1",
    "qs": "^6.7.0",
    "request": "2.81.0",
    "safeify": "^5.0.5",
    "sha.js": "2.4.9",
    "sha1": "1.1.1",
    "swagger-client": "^3.5.1",
    "underscore": "1.8.3",
    "yapi-plugin-qsso": "^1.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.22.20",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.22.15",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-transform-runtime": "7.22.15",
    "@babel/preset-env": "7.22.20",
    "@babel/preset-react": "7.22.15",
    "@babel/register": "7.22.15",
    "@babel/runtime": "7.22.15",
    "ava": "3.15.0",
    "babel-eslint": "^7.2.3",
    "babel-plugin-module-resolver": "4.1.0",
    "conventional-changelog-cli": "^2.1.1",
    "eslint": "^3.19.0",
    "eslint-plugin-import": "^2.2.0",
    "eslint-plugin-react": "^7.1.0",
    "ghooks": "^2.0.0",
    "nodemon": "^1.11.0",
    "rewire": "^2.5.2",
    "validate-commit-msg": "^2.12.2"
  },
  "config": {
    "ghooks": {
      "commit-msg": "validate-commit-msg"
    },
    "validate-commit-msg": {
      "types": [
        "feat",
        "fix",
        "docs",
        "test",
        "chore",
        "refactor",
        "opti"
      ],
      "warnOnFail": false,
      "maxSubjectLength": 100,
      "subjectPattern": ".+",
      "subjectPatternErrorMsg": "请输入message信息!",
      "helpMessage": "Commit message 格式错误， http://www.ruanyifeng.com/blog/2016/01/commit_message_change_log.html"
    }
  },
  "engines": {
    "node": "12.22.x",
    "npm": "^6.14.0"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "loose": true,
          "modules": false,
          "targets": {
            "node": "12.22"
          }
        }
      ],
      "@babel/preset-react"
    ],
    "plugins": [
      [
        "@babel/plugin-proposal-decorators",
        {
          "legacy": true
        }
      ],
      [
        "@babel/plugin-proposal-class-properties",
        {
          "loose": true
        }
      ],
      "@babel/plugin-proposal-object-rest-spread",
      [
        "@babel/plugin-transform-runtime",
        {
          "regenerator": true
        }
      ],
      [
        "module-resolver",
        {
          "alias": {
            "client": "./client",
            "common": "./common",
            "exts": "./exts",
            "models": "./server/models",
            "utils": "./server/utils",
            "yapi.js": "./server/yapi.js"
          }
        }
      ]
    ],
    "env": {
      "test": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "loose": true,
              "modules": "commonjs",
              "targets": {
                "node": "12.22"
              }
            }
          ],
          "@babel/preset-react"
        ]
      }
    }
  },
  "ava": {
    "files": [
      "test/**/*.js",
      "!test/babel-register.js"
    ]
  }
}
